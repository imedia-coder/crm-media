# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (Neon: dashboard -> Connection string).
# Owner role, used only for migrations — has BYPASSRLS on Neon by default.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Non-bypassrls role the application connects as at runtime, so tenant
# isolation (Row-Level Security) is actually enforced. Create it once with:
#   CREATE ROLE app_runtime LOGIN PASSWORD '...' NOBYPASSRLS;
#   GRANT CONNECT ON DATABASE <db> TO app_runtime;
#   GRANT USAGE ON SCHEMA public TO app_runtime;
#   GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO app_runtime;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO app_runtime;
RUNTIME_DATABASE_URL="postgresql://app_runtime:password@host/dbname?sslmode=require"

# JWT — access token uniquement (JwtAccessStrategy). Le refresh token est un
# jeton opaque genere aleatoirement (voir TokenService), pas un JWT : il n'a
# pas besoin de secret de signature.
JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

PORT=3001

# Document/media storage. Defaults to local disk (STORAGE_ROOT, ./storage
# if unset). Set STORAGE_DRIVER=s3 to use an S3-compatible backend instead
# (Cloudflare R2, AWS S3, ...) and fill in the S3_* variables below.
STORAGE_ROOT="./storage"

# Base d'URL publique des médias, utilisée par les adaptateurs réseaux qui
# tirent le fichier depuis une URL (Meta, TikTok). Ex. domaine public d'un
# bucket R2. Sinon on tente endpoint/bucket/key (bucket en lecture publique).
# MEDIA_PUBLIC_BASE="https://media.iniciativasmedia.fr"

# STORAGE_DRIVER="s3"
# Cloudflare R2: endpoint is https://<ACCOUNT_ID>.r2.cloudflarestorage.com,
# region is "auto". For AWS S3, use the bucket's region and omit S3_ENDPOINT.
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="crm-media-documents"
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."

# AI assistant (Anthropic API). Get a key at console.anthropic.com.
ANTHROPIC_API_KEY="sk-ant-..."

# WhatsApp (Whapi.Cloud — sole provider for V1). Per-tenant channel tokens
# live in the whatsapp_channels table, not here.
WHAPI_BASE_URL="https://gate.whapi.cloud"
# Public origin this API is reachable at, used to build the webhook URL
# shown in the channel-setup screen for pasting into Whapi's dashboard.
API_PUBLIC_URL="http://localhost:3001"

# Publication scheduler tick (PublishSchedulerService). Set to "false" to
# disable the in-process cron (tests, or when a single node must own it).
# PUBLISH_SCHEDULER_ENABLED="true"

# Base publique de l'app web, pour la redirection retour après OAuth social.
WEB_APP_URL="http://localhost:3000"

# Chiffrement des secrets stockés (social_accounts.accessTokenEnc, et depuis
# peu users.mfaSecret). 32 octets base64 :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Absente en dev => secrets stockés en clair (avertissement au démarrage).
# TOKEN_ENCRYPTION_KEY=""

# ---- Réseaux sociaux (voir docs/SETUP-META-TIKTOK.md) ----
# Identifiants au niveau app uniquement ; les jetons par compte client vivent
# dans la table social_accounts (chiffrés).
# META_APP_ID=""
# META_APP_SECRET=""
# META_GRAPH_VERSION="v21.0"
# META_REDIRECT_URI="https://<tunnel>/social/meta/callback"
# META_WEBHOOK_VERIFY_TOKEN=""   # chaîne aléatoire de ton choix
# TIKTOK_CLIENT_KEY=""
# TIKTOK_CLIENT_SECRET=""
# TIKTOK_REDIRECT_URI="https://<tunnel>/social/tiktok/callback"
